    "class IPW_Estimator:\n",
    "\n",
    "    def __init__(self, k_range, criterion=\"bic\", cov_type='uni_diag', n_init=5):\n",
    "        self.gmm = GaussianMixtureMAR(k_range=k_range, criterion=criterion, cov_type=cov_type, n_init=n_init)\n",
    "        self.gmm_m0 = GaussianMixtureMAR(k_range=k_range, criterion=criterion, cov_type=cov_type, n_init=n_init)\n",
    "        self.pm0 = 0\n",
    "        \n",
    "    def fit(self, X, M):\n",
    "        # Estimate p(x)\n",
    "        self.gmm.fit(X, M)\n",
    "    \n",
    "        # Estimate p(x|M=0)\n",
    "        idx_m0 = M.sum(dim=1)==d\n",
    "        self.gmm_m0.fit(X[idx_m0], M[idx_m0])\n",
    "\n",
    "        # Estimate P(M=0)\n",
    "        self.pm0 = ((M.sum(dim=1) == d).sum() / M.shape[0]).item()\n",
    "    \n",
    "    def evaluate(self, X):\n",
    "        # Estimate P(M=0|x) = p(x|M=0) * P(M=0) / p(x)\n",
    "        log_ratio = self.gmm_m0.log_prob_x(X) + torch.log(torch.as_tensor(self.pm0)) - self.gmm.log_prob_x(X)\n",
    "        return torch.exp(log_ratio).clamp(max=1.0)"
   ]
