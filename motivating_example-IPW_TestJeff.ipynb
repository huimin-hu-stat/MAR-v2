    "def eval_p0_true(X):\n",
    "    U1, U2 = dg.latent_uniforms(X)\n",
    "    G1 = torch.maximum(U1, dg.c)\n",
    "    G2 = torch.maximum(U2, dg.c)\n",
    "    return (G1+G2)/3"
