    "    # p0_nmmipw_test[i] = np.asarray(predict_prop(ps, r_Xtest, pre.rx2(\"pattern\")))\n",
    "\n",
    "    # p0_nmmipw_train.append(np.asarray(ps.rx2(\"prop\")))\n",
    "    # quantile_p0_nmmipw[i] = np.quantile(Xm0_np[:,0], 0.1, method=\"inverted_cdf\", weights=1/p0_nmmipw_train[i])\n",
    "    # #==================#\n",
    "\n",
    "    # cross-fit IPW and quantile estimation\n",
    "    if cross_fitting:\n",
    "        X1, X2, M1, M2 = train_test_split(Xm, M, test_size=0.5)\n",
    "        \n",
    "        for j, X_ipw, M_ipw, X_quant, M_quant in [(1, X1, M1, X2, M2), (2, X2, M2, X1, M1)]:\n",
    "            p0_est_test[i][j], p0_train, quantile_p0_est[i][j] = est_ipw_quant(X_ipw, M_ipw, X_quant, M_quant)\n",
    "            p0_est_train.append({f'fold{j}': p0_train})\n",
    "            \n",
    "        p0_est_test[i][0] = (p0_est_test[i][1] + p0_est_test[i][2])/2\n",
