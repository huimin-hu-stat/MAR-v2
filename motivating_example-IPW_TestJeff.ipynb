    "quantile_p0_true = np.zeros(B)\n",
    "\n",
    "p0_nmmipw_train = []\n",
    "p0_nmmipw_test = np.zeros((B, n_test))\n",
    "quantile_p0_nmmipw = np.zeros(B)\n",
    "\n",
    "p0_est_train = []\n",
    "if cross_fitting:\n",
    "    p0_est_test = np.zeros((B, 3, n_test))\n",
    "    quantile_p0_est = np.zeros((B, 3))\n",
    "else:\n",
    "    p0_est_test = np.zeros((B, n_test))\n",
    "    quantile_p0_est = np.zeros(B)\n",
    "\n",
    "\n",
    "for i in range(B):\n",
    "    # Sample X, M\n",
    "    X = dg.sample_truth(n, d)\n",
    "    M = dg.generate_MNAR1(X, 0.0)\n",
    "    # Ampute X accordingly\n",
    "    Xm = X.clone()\n",
    "    Xm[M == 0] = 0\n",
    "\n",
    "    # Determine unweighted quantile and that using the true IPW (on the whole dataset)\n",
    "    idx_m0 = M.sum(dim=1)==d\n",
    "    Xm0 = Xm[idx_m0]\n",
    "    Xm0_np = Xm0.detach().numpy()\n",
    "    quantile_unweighted[i] = np.quantile(Xm0_np[:,0], 0.1)\n",
    "    quantile_p0_true[i] = np.quantile(Xm0_np[:,0], 0.1, method=\"inverted_cdf\", weights=1/eval_p0_true(Xm0).detach().numpy())\n",
    "\n",
    "    # evaluate P(M=0|x) on a test set for evaluation\n",
    "    Xtest = dg.sample_truth(n_test, d)\n",
    "    p0_true_test[i] = eval_p0_true(Xtest)\n",
    "    p0_true_train.append(eval_p0_true(Xm0))\n",
