    "def plot_true_vs_est(axis, list_true, list_est, ylabel):\n",
    "    for ax, p0_true, p0_est in zip(axis, list_true, list_est):\n",
    "        ax.hexbin(p0_true, p0_est, gridsize=40, bins='log')\n",
    "        ax.plot([0,1],[0,1],'r')\n",
    "        ax.set_xlabel('True P(M=0|x)')\n",
    "    axis[0].set_ylabel(ylabel)"
   ]
