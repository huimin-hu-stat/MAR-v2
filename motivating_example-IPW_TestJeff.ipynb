    "def est_ipw_quant(X_ipw, M_ipw, X_quant, M_quant):\n",
    "    ipw_est = IPW_Estimator(k_range=kk)\n",
    "    ipw_est.fit(X_ipw, M_ipw)\n",
    "    \n",
    "    p0_test = ipw_est.evaluate(Xtest)\n",
    "\n",
    "    idx_m0 = M_quant.sum(dim=1)==d\n",
    "    Xm0 = X_quant[idx_m0]\n",
    "    Xm0_np = Xm0.detach().numpy()\n",
    "    p0_train = ipw_est.evaluate(Xm0)\n",
    "    quantile_p0 = np.quantile(Xm0_np[:,0], 0.1, method=\"inverted_cdf\", weights=1/np.maximum(p0_train.detach().numpy(), 0.00001))\n",
    "    #quantile_p0 = np.quantile(Xm0_np[:,0], 0.1, method=\"inverted_cdf\", weights=1/p0_train.detach().numpy())\n",
    "\n",
    "    return p0_test, p0_train, quantile_p0"
